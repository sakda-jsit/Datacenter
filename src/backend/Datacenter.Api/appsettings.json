{
  // ค่าที่เป็นความลับ (connection string / Jwt:Key) ต้อง "ไม่" อยู่ในไฟล์นี้ เพราะไฟล์นี้ commit ลง git
  // ตั้งได้ 2 ทาง: (1) environment variable เช่น ConnectionStrings__DefaultConnection, Jwt__Key
  //               (2) ไฟล์ appsettings.Local.json ข้าง ๆ ไฟล์นี้ (อยู่ใน .gitignore แล้ว)
  // ระบบจะไม่สตาร์ตถ้าค่าเหล่านี้ว่าง — ดู StartupConfigValidator
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Datacenter.Api",
    "Audience": "Datacenter.Frontend"
  },
  "Auth": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Cors": {
    // origin ของ frontend (ตอน deploy แยกโดเมน). ว่าง = ไม่เปิด CORS
    // (กรณี serve frontend จาก wwwroot ของ API เดียวกัน ไม่ต้องตั้ง)
    "AllowedOrigins": []
  },
  "Hosting": {
    // ตั้ง false เมื่อ TLS จบที่ reverse proxy (IIS/nginx) แล้ว เพื่อไม่ให้ redirect ซ้ำซ้อน
    "UseHttpsRedirection": true
  },
  "Import": {
    "ExpressBasePath": "J:\\",
    "SnapshotBasePath": "D:\\ExpressSnapshots"
  },
  "Wht": {
    "CertificateFont": "Tahoma"
  },
  // หน้าเอกสาร API (/swagger) — Development เปิดอยู่แล้วโดยไม่ต้องตั้งค่านี้
  // production: ตั้ง true เฉพาะช่วงที่ต้องใช้ทดสอบ แล้วปิดกลับ
  "Swagger": {
    "Enabled": false
  },
  "EmailSettings": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "JSP Datacenter"
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "FilePrefix": "datacenter",
      "MinimumLevel": "Information",
      "RetainedDays": 90
    }
  }
}
