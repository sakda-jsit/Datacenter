  updateEnrollment: (
    id: number,
    clientCompanyId: number,
    body: { submittedDate?: string | null; status: number; proofDocumentId?: number | null; note?: string },
  ) =>
    apiClient
      .put(`/payroll/sso-enrollments/${id}`, body, { params: { clientCompanyId } })
      .then((r) => r.data),

  // งวดเงินเดือนรายเดือน
