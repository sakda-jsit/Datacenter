# -*- coding: utf-8 -*-
"""สร้างเอกสารแนวทางพัฒนา Web Application (JSP CONNX) เป็นไฟล์ Word"""
import os
from docx import Document
from docx.shared import Pt, RGBColor, Inches
from docx.enum.text import WD_ALIGN_PARAGRAPH
from docx.oxml.ns import qn

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(HERE, "..", "JSPC_WebApp_Guideline.docx")
FONT = "TH Sarabun New"

doc = Document()
# ตั้งฟอนต์ไทยทั้งเอกสาร
st = doc.styles["Normal"]
st.font.name = FONT
st.font.size = Pt(14)
st.element.rPr.rFonts.set(qn("w:cs"), FONT)
st.element.rPr.rFonts.set(qn("w:eastAsia"), FONT)

NAVY = RGBColor(0x1F, 0x38, 0x64)


def _setfont(run, size=14, bold=False, color=None):
    run.font.name = FONT
    run.font.size = Pt(size)
    run.bold = bold
    if color:
        run.font.color.rgb = color
    rpr = run._element.get_or_add_rPr()
    rf = rpr.get_or_add_rFonts()
    rf.set(qn("w:cs"), FONT)
    rf.set(qn("w:ascii"), FONT)
    rf.set(qn("w:hAnsi"), FONT)


def h(text, size=16, space_before=10):
    p = doc.add_paragraph()
    p.paragraph_format.space_before = Pt(space_before)
    p.paragraph_format.space_after = Pt(4)
    _setfont(p.add_run(text), size, True, NAVY)
    return p


def para(text, size=14, bold=False, align=None, after=4):
    p = doc.add_paragraph()
    p.paragraph_format.space_after = Pt(after)
    if align:
        p.alignment = align
    _setfont(p.add_run(text), size, bold)
    return p


def bullet(text, size=14):
    p = doc.add_paragraph(style="List Bullet")
    _setfont(p.add_run(text), size)
    return p


def table(headers, rows, widths=None):
    t = doc.add_table(rows=1, cols=len(headers))
    t.style = "Light Grid Accent 1"
    for i, hd in enumerate(headers):
        c = t.rows[0].cells[i]
        c.paragraphs[0].clear()
        _setfont(c.paragraphs[0].add_run(hd), 13, True)
    for row in rows:
        cells = t.add_row().cells
        for i, v in enumerate(row):
            cells[i].paragraphs[0].clear()
            _setfont(cells[i].paragraphs[0].add_run(str(v)), 13)
    if widths:
        for r in t.rows:
            for i, w in enumerate(widths):
                r.cells[i].width = Inches(w)
    return t


# ============ ปก ============
para("เอกสารแนวทางการพัฒนา", 22, True, WD_ALIGN_PARAGRAPH.CENTER, after=2)
para("ระบบรายงานการเงินแบบเว็บแอปพลิเคชัน", 22, True, WD_ALIGN_PARAGRAPH.CENTER, after=2)
para("บริษัท เจเอสพี คอนเนกซ์ จำกัด (JSP CONNX CO., LTD.)", 16, False, WD_ALIGN_PARAGRAPH.CENTER, after=2)
para("เชื่อมโยงข้อมูลจากโปรแกรม Express สู่ฐานข้อมูล SQL Server", 14, False, WD_ALIGN_PARAGRAPH.CENTER)
para("ฉบับร่างเพื่อพิจารณา | เฟส 1: งบการเงิน", 13, False, WD_ALIGN_PARAGRAPH.CENTER)
doc.add_paragraph()

# ============ 1 บทสรุปผู้บริหาร ============
h("1. บทสรุปผู้บริหาร")
para("ปัจจุบันบริษัทบันทึกข้อมูลบัญชีทั้งหมดในโปรแกรม Express และจัดทำงบการเงิน/รายงานภาษีด้วยการ "
     "ส่งออกข้อมูลมาทำต่อในไฟล์ Excel ขนาดใหญ่ (62 ชีต) ด้วยมือ ซึ่งใช้เวลามาก แก้ไขยาก และเสี่ยงต่อความผิดพลาด")
para("โครงการนี้เสนอให้พัฒนาเว็บแอปพลิเคชันภายในองค์กร โดย (1) ดึงข้อมูลที่จำเป็นจาก Express เข้าสู่ฐานข้อมูล "
     "SQL Server ผ่านการกดปุ่ม “Sync” (2) เก็บ logic การจัดทำงบไว้ในระบบ และ (3) ออกงบการเงิน/รายงานให้พนักงาน "
     "~10 คนเรียกดูและพิมพ์ได้เอง โดย Express ยังเป็นที่บันทึกข้อมูลตั้งต้นเหมือนเดิม")
para("เฟสแรกมุ่งที่ “งบการเงิน” ก่อน ทีมงานได้พิสูจน์แล้วว่าสามารถคำนวณงบฐานะการเงินและงบกำไรขาดทุน "
     "จากงบทดลองของ Express ได้ตรงกับไฟล์ Excel เดิมทุกบรรทัด (ดูหัวข้อ 6)", bold=True)

# ============ 2 วัตถุประสงค์/ขอบเขต ============
h("2. วัตถุประสงค์และขอบเขตเฟส 1")
bullet("ลดงานทำมือใน Excel และความเสี่ยงจากสูตรข้ามชีตจำนวนมาก")
bullet("ให้ผู้จัดทำและผู้สอบทานเรียกดูงบการเงินที่อัปเดตได้เองผ่านเว็บ (ภายใน LAN)")
bullet("วางรากฐานฐานข้อมูล SQL Server เพื่อต่อยอดโมดูลภาษี/สต็อก/ลูกหนี้-เจ้าหนี้ในเฟสถัดไป")
para("ขอบเขตเฟส 1:", bold=True, after=0)
bullet("ดึง “งบทดลอง” (Trial Balance) ปีปัจจุบันและปีก่อนจาก Express")
bullet("ออกงบฐานะการเงิน (BAL) และงบกำไรขาดทุน (PL) พร้อมเปรียบเทียบปีก่อน + ส่งออก Excel/PDF")
bullet("ระบบผู้ใช้ 2 บทบาท: ผู้จัดทำ (Maker) และผู้สอบทาน (Checker)")
para("นอกขอบเขตเฟส 1: การบันทึกรายการแทน Express, รายงานภาษี (VAT/ภงด.), สต็อก, การเขียนข้อมูลกลับเข้า Express")

# ============ 3 สถาปัตยกรรม ============
h("3. สถาปัตยกรรมระบบ (ติดตั้งบนเซิร์ฟเวอร์ในออฟฟิศ)")
para("ข้อมูลไหลทางเดียวจาก Express → SQL Server → เว็บแอป โดยไม่เขียนกลับเข้า Express เพื่อความปลอดภัย", bold=True)
para("[ เครื่องที่มี Express + โฟลเดอร์ข้อมูล ]")
para("        │  (กดปุ่ม Sync บนเว็บ → Sync Agent อ่านข้อมูล)")
para("        ▼")
para("[ SQL Server ]   stg_trial_balance → trial_balance (clean)")
para("        │")
para("        ▼")
para("[ Web App + API บนเซิร์ฟเวอร์ในออฟฟิศ ]  ←  ผู้ใช้ ~10 คน ผ่าน LAN")
para("        (คำนวณงบ • แสดงผล • ส่งออก Excel/PDF)")

# ============ 4 ปุ่ม Sync ============
h("4. การดึงข้อมูลจาก Express ผ่านปุ่ม Sync")
para("Express ไม่มี API/ODBC แบบเปิดอย่างเป็นทางการ และเก็บข้อมูลเป็นไฟล์รูปแบบเฉพาะ (ตระกูล DBF/FoxPro) "
     "จึงเชื่อมต่อได้แบบ “อ่านอย่างเดียว” เท่านั้น แนวทางทำปุ่ม Sync มี 2 ทาง:")
table(
    ["", "ทาง A: อ่านไฟล์ข้อมูลตรง (แนะนำ)", "ทาง B: Export แล้วดูดไฟล์"],
    [["วิธี", "Sync Agent อ่านไฟล์ .dbf ของ Express", "ให้คน Export จาก Express ลงโฟลเดอร์ แล้ว Sync ดูดไฟล์"],
     ["ข้อดี", "กดปุ่มเดียวจบ ไม่ต้องเปิด Express", "ปลอดภัย ใช้ฟังก์ชันมาตรฐานของ Express"],
     ["ข้อเสีย", "ต้องถอดโครงสร้างตาราง .dbf เอง เสี่ยงไฟล์ถูกล็อก", "ต้องมีคนกด Export ทุกครั้ง ไม่ใช่ปุ่มเดียวจบ"]],
    widths=[0.8, 2.7, 2.7])
para("ข้อควรทำก่อนเริ่ม (เฟส 0): ยืนยันกับตัวแทน Express/ESG ว่าเวอร์ชัน 1.0.1.94 อนุญาตให้เข้าถึงไฟล์ .dbf "
     "และทราบโครงสร้างตาราง หาก .dbf อ่านไม่ได้ ให้ใช้ทาง B เป็นทางสำรอง", bold=True)
para("ทุกครั้งที่กด Sync ระบบจะบันทึก 1 แถวในตาราง sync_run (เวลา ปีบัญชี ผู้กด สถานะ จำนวนแถว) เพื่อตรวจสอบย้อนหลัง")

# ============ 5 Data model ============
h("5. โครงสร้างฐานข้อมูล SQL Server")
para("แบ่งเป็นชั้น Staging (ข้อมูลดิบจาก Express) และ Core (ข้อมูลที่จัดระเบียบแล้ว) ตารางหลัก:")
table(["ตาราง", "หน้าที่"],
      [["sync_run", "บันทึกการกดปุ่ม Sync แต่ละครั้ง"],
       ["stg_trial_balance", "งบทดลองดิบจาก Express (โหลดทับทุกครั้ง)"],
       ["statement_line", "นิยามบรรทัดในงบ (รหัส REF เช่น A1, I1)"],
       ["account_mapping", "ผูกเลขบัญชี → REF (93 บัญชี)"],
       ["trial_balance", "งบทดลองที่ clean แล้ว 1 บัญชี/ปี"],
       ["fs_external_input", "ค่าจากนอกงบทดลอง เช่น ภาษีเงินได้ (X4)"],
       ["app_user / app_role", "ผู้ใช้และบทบาท (Maker/Checker/Admin)"],
       ["audit_log", "บันทึกการใช้งาน (เข้าระบบ/ดูงบ/ส่งออก)"]],
      widths=[1.8, 4.4])
para("ไฟล์ schema.sql และ seed_statement_mapping.sql แนบมาพร้อมเอกสารนี้ พร้อมนำไปสร้างฐานข้อมูลได้ทันที", bold=True)

# ============ 6 เครื่องยนต์งบ + ผลพิสูจน์ ============
h("6. เครื่องยนต์งบการเงิน และผลการพิสูจน์ความถูกต้อง")
para("หัวใจของงบการเงินคือการจับ “เลขบัญชี” แต่ละตัวเข้ากับ “บรรทัดในงบ” ผ่านรหัส REF "
     "(logic นี้ซ่อนอยู่ในไฟล์ Excel เดิมแล้ว ทีมงานถอดออกมาครบ 93 บัญชี) จากนั้นรวมยอดคงเหลือตาม REF "
     "ก็ได้งบการเงินทันที")
para("ทีมงานเขียนตัวคำนวณต้นแบบ (prototype) อ่านงบทดลองปี 2568 จากไฟล์จริง แล้วเทียบกับงบในไฟล์ Excel ได้ผลดังนี้:")
table(["รายการ", "คำนวณจากระบบ", "งบเดิมระบุ", "ผล"],
      [["รวมรายได้", "3,579,157.45", "3,579,157.45", "ตรง"],
