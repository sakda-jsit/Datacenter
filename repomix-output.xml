.topbar-user{display:flex;align-items:center;gap:10px;min-width:0}
.user-avatar{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;flex:none;background:linear-gradient(135deg,var(--brand),var(--brand-2));color:#fff;font-size:15px;font-weight:850;box-shadow:0 10px 22px rgba(56,189,248,.22)}
.user-meta{display:flex;flex-direction:column;min-width:0;line-height:1.2}
.user-meta strong{max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:14px;color:var(--ink);font-weight:850}
.user-meta small{max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--muted);font-size:11px;margin-top:3px}
.logout-btn{height:36px;display:inline-flex;align-items:center;justify-content:center;padding:0 13px;border-radius:11px;border:1px solid #d9e2ec;background:#fff;color:#475569;text-decoration:none;font-size:13px;font-weight:800;transition:background .16s,color .16s,border-color .16s,transform .16s}
.logout-btn:hover{background:var(--neg-50);border-color:#fecaca;color:var(--neg);transform:translateY(-1px)}
.content-toolbar{display:none;align-items:center;gap:10px;padding:14px 20px 0 20px}
.content-sidebar-toggle,.sidebar-toggle,.hamb{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--line);background:#fff;color:var(--ink);cursor:pointer;box-shadow:var(--shadow-sm)}
.content-sidebar-toggle{height:38px;padding:0 14px;border-radius:12px;font-size:14px;font-weight:700}
.hamb{display:none;width:38px;height:38px;border-radius:12px}

/* sidebar */
.sidebar-head{display:flex;align-items:center;gap:10px;padding:18px 16px 10px}
.brand{
  display:flex; gap:13px; align-items:center; color:var(--ink); text-decoration:none;
  padding:8px 4px 8px 4px; font-weight:800; line-height:1.2; min-width:0; flex:none;
}
.sidebar-head .brand{flex:1}
.brand:hover{color:var(--ink)}
.logo{
  width:44px; height:44px; display:grid; place-items:center; border-radius:14px;
  color:#fff; font-size:15px; letter-spacing:.06em; font-weight:800;
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  box-shadow:0 12px 28px rgba(56,189,248,.30);
  flex:none;
}
.brandtext{font-size:18px;min-width:0}.brand small{display:block;color:var(--muted);font-size:12px;font-weight:500;letter-spacing:.06em;margin-top:3px}
.sidebar-toggle{width:36px;height:36px;border-radius:11px;font-size:18px;font-weight:700;flex:none}
.menu{display:flex; flex-direction:column; padding:8px 14px 18px; gap:6px}
.menutitle{padding:0 10px 4px;color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.menuitem{
  position:relative; display:flex; align-items:flex-start; gap:12px; color:var(--ink-soft); text-decoration:none;
  padding:12px 13px; border-radius:14px; transition:background .16s, color .16s, transform .16s;
}
.menuitem .ic{width:30px;height:30px;display:grid;place-items:center;flex:none;border-radius:10px;background:var(--surface-2);font-size:17px}
.menuitem .ml{flex:1; min-width:0; line-height:1.25}
.menuitem .ml strong{display:block; font-size:15px; color:inherit; font-weight:700}
.menuitem .ml small{display:block; color:var(--muted); font-size:11px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:3px}
.menuitem:hover{background:var(--brand-50); transform:translateX(2px); color:var(--brand-d)}
.menuitem.on{background:linear-gradient(135deg,var(--brand-50),#fff); color:#0789b9; box-shadow:inset 0 0 0 1px var(--brand-100)}
.menuitem.on:before{content:""; position:absolute; left:-14px; top:12px; bottom:12px; width:4px; border-radius:0 999px 999px 0; background:var(--brand)}
.menuitem.soon{opacity:.86}.menuitem.soon:hover{opacity:1}
.menuitem .tag{font-size:10px;background:var(--brand-50);color:var(--brand-d);padding:2px 8px;border-radius:999px;font-weight:700;margin-top:3px}
.menusep{height:1px;background:var(--line);margin:8px 10px}
.sidefoot{margin:auto 18px 18px; display:flex; gap:8px; align-items:center; color:var(--muted); font-size:12px; background:var(--surface-2); border:1px solid var(--line); border-radius:999px; padding:9px 12px}
.dot{width:8px;height:8px;border-radius:999px;background:var(--good);box-shadow:0 0 0 4px rgba(22,163,74,.10);display:inline-block;flex:none}

/* sidebar collapsed */
.sidebar.collapsed,
.sidebar.is-collapsed,
.sidebar-collapsed .sidebar{width:94px}
.sidebar.collapsed .brand,
.sidebar.is-collapsed .brand,
.sidebar-collapsed .brand{justify-content:center;gap:0;padding-left:0;padding-right:0}
.sidebar.collapsed .brandtext,
.sidebar.is-collapsed .brandtext,
.sidebar.collapsed .brand > span:not(.logo),
.sidebar.is-collapsed .brand > span:not(.logo),
.sidebar.collapsed .menutitle,
.sidebar.is-collapsed .menutitle,
.sidebar.collapsed .menuitem .ml,
.sidebar.is-collapsed .menuitem .ml,
.sidebar.collapsed .menuitem .tag,
.sidebar.is-collapsed .menuitem .tag,
.sidebar.collapsed .sidefoot,
.sidebar.is-collapsed .sidefoot,
.sidebar-collapsed .brandtext,
.sidebar-collapsed .brand > span:not(.logo),
.sidebar-collapsed .menutitle,
.sidebar-collapsed .menuitem .ml,
.sidebar-collapsed .menuitem .tag,
.sidebar-collapsed .sidefoot{display:none}
.sidebar.collapsed .brand small,
.sidebar.is-collapsed .brand small,
.sidebar-collapsed .brand small{display:none}
.sidebar.collapsed .sidebar-head,
.sidebar.is-collapsed .sidebar-head,
.sidebar-collapsed .sidebar-head{padding:18px 12px 10px;flex-direction:column}
.sidebar.collapsed .sidebar-toggle,
.sidebar.is-collapsed .sidebar-toggle,
.sidebar-collapsed .sidebar-toggle{transform:rotate(180deg)}
.sidebar.collapsed .menu,
.sidebar.is-collapsed .menu,
.sidebar-collapsed .menu{padding-left:10px;padding-right:10px;align-items:stretch}
.sidebar.collapsed .menuitem,
.sidebar.is-collapsed .menuitem,
.sidebar-collapsed .menuitem{justify-content:center;padding:12px 10px}
.sidebar.collapsed .menuitem .ic,
.sidebar.is-collapsed .menuitem .ic,
.sidebar-collapsed .menuitem .ic{width:38px;height:38px;font-size:19px}
.sidebar.collapsed .menuitem.on:before,
.sidebar.is-collapsed .menuitem.on:before,
.sidebar-collapsed .menuitem.on:before{left:0;top:10px;bottom:10px}
.sidebar.collapsed .menusep,
.sidebar.is-collapsed .menusep,
.sidebar-collapsed .menusep{margin-left:12px;margin-right:12px}
.sidebar-collapsed .topbar{padding-left:32px}
.sidebar-collapsed .content-toolbar{padding-left:16px}

/* typography */

h1{font-size:34px;line-height:1.2;font-weight:800;margin:0 0 7px;letter-spacing:-.025em;color:var(--ink)}
h2{font-size:23px;line-height:1.25;font-weight:800;margin:28px 0 12px;letter-spacing:-.01em}
h3.sec{font-size:16px;font-weight:800;color:var(--brand-d);margin:24px 0 10px;letter-spacing:.02em;display:flex;align-items:center;gap:8px}
h3.sec:before{content:"";width:8px;height:8px;border-radius:999px;background:var(--brand)}
.financial-heading{display:flex;align-items:center;gap:12px;font-size:33px;margin:0;letter-spacing:0;color:#0b83b5}
.heading-icon{width:42px;height:42px;display:grid;place-items:center;flex:none;border-radius:14px;background:var(--brand-50);border:1px solid var(--brand-100);font-size:23px;color:inherit}
.muted{color:var(--muted)}.small{font-size:13px}.mono{font-family:Consolas,"SF Mono","Courier New",monospace;font-size:14px}.right{text-align:right}.pathcell{max-width:360px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--brand-d);font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}.eyebrow:before{content:"";width:22px;height:2px;border-radius:999px;background:linear-gradient(90deg,var(--brand),var(--brand-2))}

/* breadcrumb */
.crumb{display:flex;gap:7px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--muted);margin-bottom:18px}.crumb a{text-decoration:none;color:var(--muted);font-weight:600}.crumb a:hover{color:var(--brand)}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(135deg,var(--brand),var(--brand-d));color:#fff;text-decoration:none;padding:10px 18px;border-radius:12px;border:0;cursor:pointer;font-size:15px;font-weight:750;box-shadow:0 10px 20px rgba(56,189,248,.20);transition:transform .14s,box-shadow .14s,background .14s,color .14s,border-color .14s}.btn:hover{color:#fff;transform:translateY(-1px);box-shadow:0 14px 26px rgba(56,189,248,.28)}.btn.ghost{background:var(--surface);color:var(--brand);border:1px solid var(--line);box-shadow:none}.btn.ghost:hover{background:var(--brand-50);border-color:var(--brand-100);color:var(--brand-d)}.btn.sm{padding:7px 12px;font-size:13px;border-radius:10px}.btn.danger{background:var(--surface);color:var(--neg);border:1px solid #fecaca;box-shadow:none}.btn.danger:hover{background:var(--neg-50);color:var(--neg)}
.actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}

/* hero & cards */
.hero{position:relative;overflow:hidden;display:flex;justify-content:space-between;gap:24px;align-items:stretch;background:linear-gradient(135deg,#fff 0%,var(--brand-50) 52%,#e9faff 100%);border:1px solid var(--brand-100);border-radius:26px;padding:32px;box-shadow:var(--shadow-sm);margin-bottom:26px}.hero:after{content:"";position:absolute;right:-90px;top:-90px;width:230px;height:230px;border-radius:50%;background:rgba(56,189,248,.12)}.hero>div{position:relative;z-index:1}.hero p{max-width:680px;margin:0}.hero-stats{display:flex;gap:14px;align-items:stretch}.stat{min-width:132px;background:rgba(255,255,255,.78);border:1px solid var(--line);border-radius:18px;padding:16px;text-align:center}.stat span{display:block;color:var(--muted);font-size:12px}.stat strong{display:block;color:var(--ink);font-size:30px;line-height:1.1;margin-top:6px}
.section-head,.page-title{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:18px}.section-head h2,.page-title h1{margin:0}.dashboard-head{margin:8px 0 32px}.dashboard-head h1{margin-bottom:14px}.dashboard-head p{margin:0}.refresh-btn{height:44px;padding:0 16px;color:#0b83b5;border-color:var(--brand-100)}.refresh-btn span{font-size:17px;line-height:1}.card,.card-lite,.table-card{background:rgba(255,255,255,.92);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-sm)}.card{padding:26px}.card-lite{padding:16px}.table-card{overflow:hidden;width:100%}.modgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:0}.modcard{display:flex;gap:16px;align-items:flex-start;position:relative;overflow:hidden;min-height:140px;background:rgba(255,255,255,.94);border:1px solid var(--line);border-radius:18px;padding:22px;text-decoration:none;color:var(--ink);box-shadow:0 8px 26px rgba(15,23,42,.05);transition:transform .16s,border-color .16s,box-shadow .16s}.modcard:after{content:"";position:absolute;right:-36px;bottom:-36px;width:110px;height:110px;border-radius:999px;background:var(--brand-50);transition:transform .18s}.modcard:hover{color:var(--ink);border-color:var(--brand-100);box-shadow:var(--shadow);transform:translateY(-3px)}.modcard:hover:after{transform:scale(1.25)}.modcard.soon{opacity:.82}.modcard.soon:hover{opacity:1}.modicon{width:52px;height:52px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(135deg,var(--brand-50),#fff);border:1px solid var(--brand-100);font-size:27px;flex:none}.modbody{position:relative;z-index:1;min-width:0}.modtitle{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:18px;font-weight:850;margin-bottom:6px;line-height:1.25}.moddesc{color:var(--muted);font-size:13px;line-height:1.55}.modlink{margin-top:16px;color:var(--brand);font-size:13px;font-weight:800}.modlink span{transition:transform .14s;display:inline-block}.modcard:hover .modlink span{transform:translateX(3px)}.tag{display:inline-block;font-size:11px;background:var(--brand-50);color:var(--brand-d);padding:2px 9px;border-radius:999px;font-weight:750;vertical-align:middle}

/* search + inputs */
.toolbar{display:flex;gap:14px;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap}.toolbar.card-lite{padding:16px;border-color:#dff4ff;background:rgba(255,255,255,.96)}.search{position:relative;flex:1;min-width:280px;margin:0}.search-ic{position:absolute;left:17px;top:50%;transform:translateY(-50%);color:#7aaabd;font-size:21px}.search input{width:100%;height:52px;padding:0 18px 0 48px;font-size:15px;border:1px solid #dbe8ef;border-radius:16px;background:#fff;color:var(--ink);transition:border-color .16s,box-shadow .16s}input,select{border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink)}input:focus,select:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 4px rgba(56,189,248,.16)}

/* tables */
table.grid{width:100%;border-collapse:separate;border-spacing:0;background:transparent}table.grid th{background:linear-gradient(180deg,var(--brand-50),#f8fdff);text-align:left;padding:15px 16px;font-size:12px;font-weight:850;color:#527184;border-bottom:1px solid #dff4ff;letter-spacing:.04em;text-transform:uppercase}table.grid td{padding:15px 16px;border-top:1px solid #edf2f6;vertical-align:middle;background:#fff;transition:background .14s}table.grid tbody tr:first-child td{border-top:0}table.grid td.name{font-weight:800;color:var(--ink)}table.grid tr:hover td{background:#f8fdff}table.grid th.amt,table.grid td.amt{text-align:right;font-variant-numeric:tabular-nums}.table-card{border-color:#dff4ff;box-shadow:0 12px 32px rgba(15,23,42,.05)}.row-action{background:var(--brand-50);color:#0b83b5;border:1px solid var(--brand-100);box-shadow:none}.row-action:hover{background:linear-gradient(135deg,var(--brand),var(--brand-d));color:#fff;border-color:transparent;box-shadow:0 10px 20px rgba(56,189,248,.22)}.pagebar{display:flex;gap:16px;align-items:center;justify-content:flex-end;flex-wrap:wrap;color:#66788a}.pagebar select{padding:7px 30px 7px 10px;font-size:13px;border-color:#dbe8ef}.pager{display:flex;gap:7px;flex-wrap:wrap;margin-top:18px;justify-content:center}.pgbtn{padding:8px 13px;font-size:13px;border:1px solid var(--line);border-radius:10px;background:#fff;cursor:pointer;color:var(--ink);font-weight:700}.pgbtn:hover:not(:disabled){border-color:var(--brand);color:var(--brand)}.pgbtn.active{background:var(--brand);color:#fff;border-color:var(--brand)}.pgbtn:disabled{opacity:.45;cursor:default}

/* year cards */
.yearcards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px;margin-top:14px}.yearcard{display:block;text-decoration:none;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;text-align:center;box-shadow:var(--shadow-sm);transition:.16s}.yearcard:hover{color:var(--ink);border-color:var(--brand-100);box-shadow:var(--shadow);transform:translateY(-3px)}.yearcard.current{border-color:var(--brand);background:linear-gradient(135deg,var(--brand-50),#fff)}.yearcard .ythai{font-size:36px;font-weight:900;color:var(--brand-d);line-height:1}.yearcard .yce{color:var(--muted);font-size:13px;margin-top:8px}.yearcard .ytag{display:inline-flex;margin-top:12px;font-size:12px;color:var(--brand-d);background:var(--brand-50);border-radius:999px;padding:4px 10px;font-weight:800}

/* statement */
.stmt-head{display:flex;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:16px}.stmt-head h1{margin:0}.period-badge{margin-left:auto;text-align:right;background:#fff;border:1px solid var(--line);border-radius:16px;padding:12px 16px;box-shadow:var(--shadow-sm)}.period-badge .py{font-size:12px;color:var(--muted)}.period-badge .pv{font-size:18px;font-weight:850;color:var(--ink)}.stmt-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;margin-top:18px}.card h2{margin-top:0;color:var(--brand-d);text-align:center;border-bottom:1px solid var(--line);padding-bottom:13px;font-size:21px}.fs{width:100%;border-collapse:collapse;margin-bottom:10px}.fs td{padding:6px 0;font-size:16px}.fs td.amt{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;font-family:Consolas,"SF Mono",monospace;font-size:15px}.fs tr.header td.lbl{font-weight:800}.fs tr.lvl1 td.lbl{padding-left:0}.fs tr.lvl2 td.lbl{padding-left:16px}.fs tr.lvl3 td.lbl{padding-left:32px}.fs tr.lvl4 td.lbl{padding-left:48px}.fs tr.lvl5 td.lbl{padding-left:64px}.fs tr.subtotal td{border-top:1px solid var(--line);font-weight:850;padding-top:8px}.fs tr.total td{border-top:2px solid var(--brand);font-weight:900;padding:9px 0;color:var(--brand-d)}.fs tr.grand td{color:var(--good)}.fs tr.aje td{color:var(--brand);font-style:italic}.adjtoggle{display:flex;gap:12px;align-items:center;margin:10px 0 16px;flex-wrap:wrap}

/* notices / pills */
.warn{color:var(--warn);background:var(--warn-50);border:1px solid #fed7aa;padding:13px 16px;border-radius:14px}.ok-msg{color:var(--good);background:var(--good-50);border:1px solid #bbf7d0;padding:13px 16px;border-radius:14px}.pill{display:inline-flex;align-items:center;padding:4px 11px;border-radius:999px;font-size:12px;background:var(--brand-50);color:var(--brand-d);font-weight:800}.pill.ok{background:var(--good-50);color:var(--good)}.pill.bad{background:var(--neg-50);color:var(--neg)}

/* forms */
.addform,.wp{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:20px;box-shadow:var(--shadow-sm)}.addform{display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;margin-top:10px}.addform label,.wp .fld,.tierbar label{display:flex;flex-direction:column;font-size:13px;color:var(--muted);gap:7px}.addform input,.rowform input,.wp .fld input,.tierbar input,.wptbl input{padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:#fff}.addform input{min-width:310px}.rowform{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.rowform input[name=path]{min-width:240px}.rowform input{font-size:13px}.wp{margin-top:10px}.wp .fld{max-width:620px;margin-bottom:14px}.wptbl input{width:100%;font-size:13px}.wptbl input.amt{text-align:right}.wptbl input.sm{max-width:82px}.tierbar{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin:10px 0}.resultbar{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;background:linear-gradient(135deg,var(--brand-50),#fff);border:1px solid var(--brand-100);border-radius:20px;padding:16px;margin:14px 0}.resultbar>div{background:rgba(255,255,255,.7);border:1px solid var(--line);border-radius:16px;padding:14px}.resultbar .big{font-size:27px;font-weight:900;line-height:1.15}.resultbar .brand{color:var(--brand)}.sched td,.sched th{padding:6px 10px;font-size:13px}.recon td.amt{font-variant-numeric:tabular-nums}.trace{background:#0f172a;color:#dbeafe;padding:16px;border-radius:14px;overflow:auto;font-size:12px}
.schedule-pager{display:flex;align-items:center;justify-content:flex-end;gap:7px;flex-wrap:wrap;margin:10px 0 22px}.schedule-page-info{margin-right:6px}

/* coming soon */
.soonbox{text-align:center;max-width:620px;margin:60px auto;background:#fff;border:1px solid var(--line);border-radius:26px;padding:46px;box-shadow:var(--shadow)}.soonicon{font-size:62px;margin-bottom:10px}.soonbox .pill{margin:12px 0}.soonbox .btn{margin-top:18px}

/* responsive */
@media (max-width:980px){.stmt-grid{grid-template-columns:1fr}.hero{flex-direction:column}.hero-stats{width:100%}.stat{flex:1}.period-badge{margin-left:0;text-align:left}.actions{width:100%}}
@media (min-width:1600px){.modgrid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media (max-width:860px){body.app{display:block}.sidebar{position:fixed;left:0;top:0;transform:translateX(-105%);transition:transform .18s;width:292px}.sidebar-open .sidebar{transform:translateX(0)}.sidebar-open:before{content:"";position:fixed;inset:0;background:rgba(15,23,42,.38);z-index:19}.sidebar-collapsed .sidebar{width:292px}.sidebar-collapsed .brandtext,.sidebar-collapsed .brand > span:not(.logo),.sidebar-collapsed .brand small,.sidebar-collapsed .menutitle,.sidebar-collapsed .menuitem .ml,.sidebar-collapsed .menuitem .tag,.sidebar-collapsed .sidefoot{display:block}.sidebar-collapsed .sidebar-head{padding:18px 16px 10px;flex-direction:row}.sidebar-collapsed .brand{justify-content:flex-start;gap:13px;padding:8px 4px}.sidebar-collapsed .menu{align-items:stretch;padding-left:14px;padding-right:14px}.sidebar-collapsed .menuitem{justify-content:flex-start;padding:12px 13px}.content-toolbar{display:flex}.hamb{display:grid;place-items:center}.content-sidebar-toggle{display:none}.container{padding:12px 16px 20px}.content-toolbar{padding:12px 16px 0 16px}.hero{padding:24px;border-radius:22px}.toolbar{display:block}.pagebar{justify-content:space-between;margin-top:12px}.table-card{overflow-x:auto}.modgrid{grid-template-columns:1fr}.section-head,.page-title{display:block}.dashboard-head{margin-top:6px;margin-bottom:20px}.stmt-head{display:block}.stmt-head .btn{margin-top:10px}.actions .btn{margin-top:0}.addform input{min-width:100%}.pathcell{max-width:260px}}
@media (max-width:560px){body{font-size:16px}h1{font-size:28px}.hero-stats{flex-direction:column}.stat{text-align:left}.modcard{padding:18px}.resultbar{grid-template-columns:1fr}.fs td{font-size:14px}.fs td.amt{font-size:13px}}
