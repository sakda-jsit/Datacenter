            ("6.12", "ภาระผูกพันและหนี้สินที่อาจจะเกิดขึ้น", 72,
                "ณ วันที่ 31 ธันวาคม พ.ศ. {{FiscalYearTh}} และ วันที่ 31 ธันวาคม พ.ศ. {{PriorYearTh}} " +
                "บริษัทฯ ไม่มีภาระผูกพันและหนี้สินที่อาจจะเกิดขึ้นที่เป็นสาระสำคัญ " +
                "(โปรดแก้ไขหากมีภาระผูกพัน เช่น หนังสือค้ำประกันธนาคาร สัญญาเช่า ฯลฯ)"),

            ("7", "การอนุมัติงบการเงิน", 200,
                "งบการเงินนี้ได้รับอนุมัติให้ออกโดยผู้เป็นกรรมการเมื่อวันที่ ......................... " +
                "(โปรดระบุวันที่อนุมัติงบการเงิน)"),
        };

        var year = DefaultEffectiveYear;
        return rows.Select(r => new NoteTemplateSection
        {
            ClientCompanyId = null,
            EffectiveYear = year,
            NoteKey = r.Key,
            Title = r.Title,
            BodyText = r.Body,
            SortOrder = r.Sort,
            CreatedAt = DateTime.UtcNow,
            CreatedBy = "system",
        }).ToList();
    }
}
