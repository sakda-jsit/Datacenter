/// <summary>
/// ข้อความบรรยายมาตรฐานของหมายเหตุประกอบงบการเงิน (NOTE2) — เกณฑ์ TFRS for NPAEs (ปรับปรุง 2566).
/// Seed เป็น template กลาง (ClientCompanyId = null) ใช้ได้ทุกบริษัท; เจ้าหน้าที่บัญชีแก้ไข/ทับเป็นรายบริษัทได้.
/// EffectiveYear = 2024 (ค.ศ.) = พ.ศ. 2567 ปีที่ TFRS for NPAEs ฉบับปรับปรุงเริ่มมีผล
/// (ระบบเก็บ FiscalYear/EffectiveYear เป็น ค.ศ. เสมอ).
///
/// placeholder ที่แทนค่าตอน render: {{CompanyName}} {{TaxId}} {{Address}}
/// {{FiscalYearTh}} (พ.ศ. ปีงบ) {{PriorYearTh}} (พ.ศ. ปีก่อน).
/// ข้อความที่ต้องเป็นข้อมูลเฉพาะบริษัท (วันจดทะเบียน, ลักษณะธุรกิจ, ชื่อกรรมการ) ใส่เป็น
/// ตัวอย่างให้เจ้าหน้าที่แก้ — ระบบไม่มีฟิลด์เหล่านี้ใน profile.
/// </summary>
public static class NoteTemplateSeed
{
    public const int DefaultEffectiveYear = 2024;

    public static List<NoteTemplateSection> GetSections()
    {
        var rows = new (string Key, string Title, int Sort, string Body)[]
        {
            ("1", "ข้อมูลทั่วไป", 10,
                "{{CompanyName}} เป็นบริษัทที่จดทะเบียนในประเทศไทย ทะเบียนนิติบุคคลเลขที่ {{TaxId}} " +
                "ที่อยู่จดทะเบียนของบริษัทฯ ตั้งอยู่เลขที่ {{Address}}\n" +
                "บริษัทฯ ประกอบกิจการในประเทศไทย โดยดำเนินธุรกิจหลักในการจำหน่ายสินค้าและให้บริการ " +
                "(โปรดแก้ไขให้ตรงกับลักษณะธุรกิจจริงของกิจการ)\n" +
