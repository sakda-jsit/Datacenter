///   Cr ราคาทุนสินทรัพย์ [cost] + Cr กำไรจากการจำหน่าย [ถ้ากำไร]
/// คิดเฉพาะสินทรัพย์ที่จำหน่าย/ขาย/ตัดจำหน่ายในปีงบนั้น.
/// </summary>
public record GenerateDisposalAdjustmentCommand(
