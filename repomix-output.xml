export interface AuthUser {
  userId: number
  username: string
  displayName: string
  role: 'Admin' | 'Maker' | 'Checker'
  token: string
  /** ใช้ต่ออายุการเข้าใช้งานเมื่อ token หมดอายุ (apiClient จัดการให้อัตโนมัติ) */
