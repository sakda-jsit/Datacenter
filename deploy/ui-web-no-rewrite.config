<?xml version="1.0" encoding="utf-8"?>
<!--
  ทางเลือกสำหรับ server ที่ "ไม่มี" IIS URL Rewrite module
  ใช้ httpErrors แทน: เส้นทางที่ไม่มีไฟล์จริง (SPA route) IIS จะได้ 404 แล้วส่ง /index.html กลับไป
  ผู้ใช้จึงเห็นหน้าเว็บและ react-router พาไปหน้าที่ถูกต้อง แม้กด F5 หรือ bookmark ลิงก์ตรง

  ข้อต่างจากแบบ rewrite ที่ต้องรู้:
    1) status ที่ส่งกลับยังเป็น 404 (IIS คงรหัสเดิมของ error ไว้ เพราะเป็น static site
       ไม่มี managed handler มาแก้เป็น 200) — browser ยังโหลดและรัน index.html ปกติ
       แต่ถ้าอนาคตมีตัว monitor คอยนับ 404 จะเห็นตัวเลขสูง ให้ไปลง URL Rewrite แทน
    2) existingResponse=Replace แทนหน้า error ของทุก 404 รวมถึงไฟล์ asset ที่หายจริง
       จะได้ index.html กลับมาแทนข้อความ error (ตอนไล่ปัญหาให้ดู network tab เป็นหลัก)
    3) ไม่มีเงื่อนไขข้าม /api (ไม่จำเป็น เพราะ site นี้เป็นไฟล์นิ่งล้วน ไม่มี API ใต้ site)

  วิธีใช้: คัดลอกไฟล์นี้ไปวางข้าง index.html ในชื่อ web.config
-->
<configuration>
  <system.webServer>

    <!-- ไม่ประกาศ defaultDocument: IIS มี index.html อยู่ในลิสต์ที่ inherit มาแล้ว
         การ <add value="index.html"/> ซ้ำเข้าไปทำให้ DefaultDocumentModule เจอ duplicate entry
         แล้วคืน 500 เฉพาะคำขอที่เป็นโฟลเดอร์ (เช่น "/") ส่วนเส้นทาง SPA อื่นยังใช้ได้ปกติ -->

    <directoryBrowse enabled="false" />

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
