<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config ของ IIS site ฝั่ง UI (ไฟล์นิ่งจาก Vite build) — วางไว้ข้าง index.html
  โครง: UI เป็น site แยก (http://js-server) เรียก API ข้าม origin ที่ http://js-server:5000

  ต้องมี IIS URL Rewrite module: https://www.iis.net/downloads/microsoft/url-rewrite
  ถ้าไม่ได้ติดตั้ง จะได้ HTTP 500.19 (config section 'rewrite' ไม่รู้จัก)
  กรณีติดตั้งไม่ได้ ให้ใช้ deploy\ui-web-no-rewrite.config แทน (ใช้ httpErrors ทำ SPA fallback)

  ตั้งใจไม่ประกาศ staticContent/mimeMap และ urlCompression ไว้ในไฟล์นี้:
  build มีแค่ .html .js .css ซึ่ง IIS รู้จักอยู่แล้ว และการ remove/add MIME ที่ซ้ำหรือไม่มีอยู่
  เป็นสาเหตุ 500.19 ที่พบบ่อย ส่วน static compression IIS เปิดเป็นค่าเริ่มต้นแล้ว
-->
<configuration>
  <system.webServer>

    <!-- ไม่ประกาศ defaultDocument: IIS มี index.html อยู่ในลิสต์ที่ inherit มาแล้ว
         การ <add value="index.html"/> ซ้ำเข้าไปทำให้ DefaultDocumentModule เจอ duplicate entry
         แล้วคืน 500 เฉพาะคำขอที่เป็นโฟลเดอร์ (เช่น "/") ส่วนเส้นทาง SPA อื่นยังใช้ได้ปกติ -->

    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <!--
          SPA fallback: react-router จัดการเส้นทางฝั่ง browser
          /companies/242/tasks ไม่มีไฟล์จริงบนดิสก์ ถ้าไม่ rewrite ผู้ใช้กด F5 จะได้ 404
          ข้ามคำขอที่ตรงไฟล์/โฟลเดอร์จริง และข้าม /api เผื่อวันหน้าย้าย API มา site เดียวกัน
        -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!--
    index.html ต้องไม่ถูก cache: ชื่อคงที่ แต่ชี้ไป bundle ที่มี hash เปลี่ยนทุก build
    ถ้า browser เก็บ index.html เก่าไว้ ผู้ใช้จะโหลด asset ที่ถูกลบแล้ว (จอขาว)
  -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- assets/: ชื่อไฟล์มี content hash cache ยาวได้ปลอดภัย -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
